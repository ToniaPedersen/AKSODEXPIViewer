        <ownedComment xmi:type="uml:Comment" xmi:id="Comment1003" annotatedElement="Class337">
          <body>A valve that has valve ports which are not in-line and that has a quarter turn action in which the closure member is a cylindrical or tapered plug which operates by rotating on its axis and sealing against a downstream seat.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="Class338" name="AngleValve">
