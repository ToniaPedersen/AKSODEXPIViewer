      <packagedElement xmi:type="uml:Class" xmi:id="Class336" name="AngleGlobeValve">
        <generalization xmi:type="uml:Generalization" xmi:id="Generalization456" general="Class326"/>
        <ownedComment xmi:type="uml:Comment" xmi:id="Comment1002" annotatedElement="Class336">
          <body>A globe valve that deviates from the in-line design, i.e. with a body shape designed to adjust the flow direction with a specified angle relative to the straight through-flow an in-line valve would have provided for (from http://data.posccaesar.org/rdl/RDS882944).</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="Class337" name="AnglePlugValve">
